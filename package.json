{
  "name": "soup-tools-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "Docs, typings, a template and examples for SOUP extensions.",
  "type": "module",
  "scripts": {
    "check": "npm run check:types && npm run check:logic && npm run check:docs && npm run build:examples",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:logic": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "check:docs": "node scripts/check-docs.mjs",
    "build:examples": "node scripts/build-example.mjs --all",
    "build:example": "node scripts/build-example.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
